{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Arquivo Atual",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}",
            "python": "${command:python.interpreterPath}",
            "redirectOutput": true,
            "stopOnEntry": false
        },
        {
            "name": "Python: Módulo Atual",
            "type": "debugpy",
            "request": "launch",
            "module": "${fileBasenameNoExtension}",
            "cwd": "${fileDirname}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "envFile": "${workspaceFolder}/.env",
            "python": "${command:python.interpreterPath}",
            "redirectOutput": true,
            "stopOnEntry": false
        },
        {
            "name": "Pytest: Arquivo Atual",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "${file}",
                "-v",
                "--tb=short"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}",
            "python": "${command:python.interpreterPath}",
            "redirectOutput": true,
            "stopOnEntry": false
        },
        {
            "name": "Pytest: Todos os Testes",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "--tb=short"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}",
            "python": "${command:python.interpreterPath}",
            "redirectOutput": true,
            "stopOnEntry": false
        }
    ]
}

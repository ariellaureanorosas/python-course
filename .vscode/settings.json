{
  // ========== APARÊNCIA E TEMA ==========
  "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-dark",
  "workbench.colorTheme": "Bearded Theme Vivid Black",
  "workbench.statusBar.visible": true,
  "workbench.layoutControl.enabled": false,
  "window.commandCenter": false,

  "editor.fontFamily": "'JetBrains Mono', monospace",
  "editor.fontSize": 17,
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.6,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.renderControlCharacters": true,
  "editor.renderLineHighlight": "gutter",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",

  "workbench.tree.indent": 20,
  "workbench.tree.renderIndentGuides": "always",
  "explorer.compactFolders": false,
  "explorer.sortOrder": "foldersNestsFiles",
  "explorer.confirmDelete": true,

  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "pyproject.toml": "uv.lock, poetry.lock, requirements*.txt, .python-version, .env*, mypy.ini, .flake8, pytest.ini",
    "README.md": "CONTRIBUTING.md, LICENSE, CHANGELOG.md"
  },

  "workbench.editor.labelFormat": "default",
  "workbench.editor.highlightModifiedTabs": true,
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "last",
  "workbench.editor.enablePreview": false,
  "editor.glyphMargin": true,


  // ========== EDITOR E FORMATAÇÃO ==========
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,

  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,

  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.suggestSelection": "first",
  "editor.snippetSuggestions": "top",

  "editor.wordWrap": "bounded",
  "editor.accessibilitySupport": "off",
  "editor.semanticHighlighting.enabled": true,
  "editor.stickyScroll.enabled": true,

  "editor.inlayHints.enabled": "onUnlessPressed",
  "editor.inlayHints.padding": true,

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.autoSave": "off",
  "files.eol": "\n",


  // ========== PYTHON ==========
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    },
    "editor.tabSize": 4,
    "editor.rulers": [88]
  },

  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.completeFunctionParens": true,

  "python.analysis.inlayHints.variableTypes": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.callArgumentNames": "all",

  "python.analysis.autoSearchPaths": true,

  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "error",
    "reportMissingTypeStubs": "information"
  },

  "python.analysis.exclude": [
    "**/__pycache__",
    "**/.venv",
    "**/venv",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/.pytest_cache"
  ],

  "python.defaultInterpreterPath": ".venv\\Scripts\\python.exe",
  "python.venvPath": ".venv",

  "python.terminal.activateEnvironment": true,
  "python.terminal.activateEnvInCurrentTerminal": true,

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "-v",
    "--tb=short"
  ],


  // ========== PYTHON INDENT ==========
  "pythonIndent.useTabOnHangingIndent": false,
  "pythonIndent.trimLinesWithOnlyWhitespace": false,
  "pythonIndent.keepHangingBracketOnLine": false,


  // ========== RUFF ==========
  "ruff.lineLength": 88,

  "ruff.lint.extendSelect": [
    "I",
    "N",
    "UP",
    "B",
    "C4",
    "SIM",
    "TCH",
    "PT"
  ],

  "ruff.organizeImports": true,


  // ========== MYPY ==========
  "mypy-type-checker.args": [
    "--show-column-numbers",
    "--pretty"
  ],

  "mypy-type-checker.reportingScope": "workspace",


  // ========== CODE RUNNER ==========
  "code-runner.runInTerminal": true,
  "code-runner.clearPreviousOutput": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.showExecutionMessage": false,
  "code-runner.ignoreSelection": true,

  "code-runner.executorMap": {
    "python": "cls && python -u $fullFileName",
    "javascript": "node",
    "typescript": "ts-node"
  },


  // ========== TERMINAL ==========
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.showExitAlert": false,
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.fontFamily": "'JetBrains Mono', monospace",


  // ========== GIT ==========
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "git.confirmSync": true,
  "git.enableForcePushWithLease": true,
  "git.openRepositoryInParentFolders": "always",
  "git.autoStash": true,
  "git.pruneOnFetch": true,


  // ========== CORREÇÃO ORTOGRÁFICA ==========
  "cSpell.language": "en,pt,pt-BR",

  "cSpell.userWords": [
    "pytest",
    "pylint",
    "flake8",
    "isort",
    "blackformatter",
    "venv",
    "virtualenv",
    "typeguard",
    "ruff",
    "mypy",
    "pyproject",
    "asyncio",
    "dataclass",
    "dunder",
    "classmethod",
    "staticmethod",
    "pydantic",
    "fastapi",
    "sqlalchemy"
  ],


  // ========== ARQUIVOS E WORKSPACE ==========
  "files.associations": {
    ".env.*": "dotenv",
    "pyproject.toml": "toml",
    "requirements*.txt": "pip-requirements"
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true
  },

  "search.exclude": {
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/.venv": true,
    "**/venv": true,
    "**/*.egg-info": true,
    "**/.env": true
  },

  "workbench.startupEditor": "none",
  "workbench.editor.empty.hint": "hidden",
  "window.autoDetectColorScheme": false,

  "security.workspace.trust.untrustedFiles": "newWindow",


  // ========== PRIVACIDADE E DESEMPENHO ==========
  "telemetry.telemetryLevel": "off",
  "extensions.ignoreRecommendations": true,
  "update.mode": "start",
  "update.showReleaseNotes": false
}
